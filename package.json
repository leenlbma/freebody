{
  "name": "freebody",
  "version": "2.8.0",
  "description": "FreeBody：AI 健身教练的仪表盘。离线单文件的训练、饮食、睡眠与身体指标记录与可视化，数据只存本机（localStorage），支持 AI 生成的导入包。",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/",
    "test:coverage": "node --test --experimental-test-coverage tests/",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p .",
    "serve": "node scripts/serve.js 8766",
    "verify": "npm run build && npm run check && npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
